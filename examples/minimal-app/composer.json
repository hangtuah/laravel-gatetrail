{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hangtuah/gatetrail-minimal-example",
    "type": "project",
    "description": "Minimal Laravel consumer application for GateTrail",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "reference": "config",
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "hangtuah/laravel-gatetrail": "dev-main",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
