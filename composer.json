{
    "name": "hangtuah/laravel-gatetrail",
    "description": "Roles, permissions, and authorization for Laravel",
    "keywords": [
        "authorization",
        "laravel",
        "permissions",
        "rbac",
        "roles"
    ],
    "homepage": "https://github.com/hangtuah/laravel-gatetrail",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mohd Fairus bin Ahmad",
            "email": "mohdfairusahmad@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/hangtuah/laravel-gatetrail/issues",
        "source": "https://github.com/hangtuah/laravel-gatetrail"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "HangTuah\\GateTrail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HangTuah\\GateTrail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HangTuah\\GateTrail\\GateTrailServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@composer validate --strict --no-check-lock",
            "@format:test",
            "@analyse",
            "@test"
        ],
        "ddl:generate": "php tools/generate-ddl-artifacts.php",
        "format": "pint",
        "format:test": "pint --test",
        "test": "phpunit",
        "test:mysql": "phpunit -c phpunit.mysql.xml",
        "test:oracle": "tools/oracle-integration/vendor/bin/phpunit -c phpunit.oracle.xml"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
